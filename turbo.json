{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".expo/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "codegen": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "//#fix:root": {
      "cache": false
    },
    "//#lint:root": {}
  }
}
