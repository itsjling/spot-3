{
  "name": "@spot/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "build": "expo export --platform ios",
    "check": "ultracite check .",
    "dev": "expo start",
    "fix": "ultracite fix .",
    "ios": "expo start --ios",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@spot/backend": "*",
    "@spot/domain": "*",
    "convex": "^1.28.0",
    "expo": "^54.0.0",
    "expo-linking": "^8.0.0",
    "expo-location": "^19.0.0",
    "expo-router": "^6.0.0",
    "expo-status-bar": "^3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "4.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ]
  }
}
